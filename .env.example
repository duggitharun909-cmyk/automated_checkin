# Office Tracker Portal - shared settings template
# Per-user logins go in users.json (copy users.json.example and fill in real accounts)
PORTAL_URL=https://office-tracker-1.vercel.app/login

# Office Geolocation (TechGy Office Premises)
# Extracted from Office Tracker geofence (2000m radius)
OFFICE_LATITUDE=17.4835258
OFFICE_LONGITUDE=78.3808618

# Scheduling Window (Hours 0-23, Minutes 0-59) - always interpreted in OFFICE_TIMEZONE,
# never the machine's own clock (GitHub Actions runners run in UTC)
CHECKIN_WINDOW_START=09:32
CHECKIN_WINDOW_END=09:48
OFFICE_TIMEZONE=Asia/Kolkata
